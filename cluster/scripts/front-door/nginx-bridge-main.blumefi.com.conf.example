# Browser front door for the bridge cluster at bridge-main.blumefi.com: 5 nodes. Generated by scripts/front-door/gen-nginx.js; regenerate, do not hand-edit.
# Valid TLS on 8443-8447 so hotpocket-js-client in a browser can connect. Each port proxies PLAIN WebSocket to the relay
# (relay.js, 127.0.0.1:9091-9095), which dials the node's user port. Never point nginx's own TLS client at a node: hpws answers it about 4 times in 10.
# The node user ports stay local; only the public ports above are opened.
server {
    listen 80;
    server_name bridge-main.blumefi.com;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 404; }
}
server {
    listen 8443 ssl;
    server_name bridge-main.blumefi.com;
    ssl_certificate /etc/letsencrypt/live/bridge-main.blumefi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge-main.blumefi.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9091; # relay -> node 1
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host 127.0.0.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
server {
    listen 8444 ssl;
    server_name bridge-main.blumefi.com;
    ssl_certificate /etc/letsencrypt/live/bridge-main.blumefi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge-main.blumefi.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9092; # relay -> node 2
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host 127.0.0.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
server {
    listen 8445 ssl;
    server_name bridge-main.blumefi.com;
    ssl_certificate /etc/letsencrypt/live/bridge-main.blumefi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge-main.blumefi.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9093; # relay -> node 3
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host 127.0.0.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
