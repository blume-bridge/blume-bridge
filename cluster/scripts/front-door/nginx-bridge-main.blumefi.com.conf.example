    listen 8446 ssl;
    server_name bridge-main.blumefi.com;
    ssl_certificate /etc/letsencrypt/live/bridge-main.blumefi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge-main.blumefi.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9094; # relay -> node 4
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host 127.0.0.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
server {
    listen 8447 ssl;
    server_name bridge-main.blumefi.com;
    ssl_certificate /etc/letsencrypt/live/bridge-main.blumefi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bridge-main.blumefi.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:9095; # relay -> node 5
        proxy_http_version 1.1;
